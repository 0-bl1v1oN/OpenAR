# Cross-compile OpenRadar Windows .exe from Linux.
#
# gopacket's Windows pcap backend loads Npcap's wpcap.dll dynamically at runtime,
# so the build does not need the Npcap SDK or a MinGW toolchain. End users still
# need Npcap installed on Windows before running OpenRadar.
#
# Usage:
#   docker build -f Dockerfile.windows -o dist/ \
#     --build-arg VERSION=x.y.z --build-arg BUILD_TIME=2026-04-15T12:00:00Z .

FROM golang:1.26-bookworm AS builder

ARG VERSION=dev
ARG BUILD_TIME=unknown

WORKDIR /app


COPY go.mod go.sum ./
RUN go mod download

COPY . .

ENV CGO_ENABLED=0 \
    GOOS=windows \
    GOARCH=amd64

RUN go build -ldflags="-s -w -X main.Version=${VERSION} -X main.BuildTime=${BUILD_TIME}" \
    -o /out/OpenRadar-windows-amd64.exe ./cmd/radar

RUN go build -ldflags="-s -w -H=windowsgui -X main.Version=${VERSION} -X main.BuildTime=${BUILD_TIME} -X main.DefaultDesktop=true" \
    -o /out/OpenRadar-windows-desktop-amd64.exe ./cmd/radar

    FROM scratch
COPY --from=builder /out/OpenRadar-windows-amd64.exe /
COPY --from=builder /out/OpenRadar-windows-desktop-amd64.exe /